#include <iostream>
#include <string>
using namespace std;

void reverse(const string& str) {
    for (int i = str.size() - 1; i >= 0; --i){
        cout << str[i];}
}
int main() {
    setlocale(0,"Rus");
    string text ="Testing";
    cout <<"Строка: "<<text<<endl;
    cout <<"Перевёрнутая строка: ";
    reverse(text);
    cout <<endl;
    return 0;
}
