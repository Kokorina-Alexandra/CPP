#include <iostream>
using namespace std;

int main() {
    cout << '\t';
    for (int i = 1; i <= 10; i++) {
            cout << i << '\t';}
    cout<<endl;
    for (int n = 1; n <= 10; n++) {
            cout << n << '\t';
            for (int k = 1; k <= 10; k++) {
                cout << n * k << '\t';}
            cout << endl;}
    return 0;}
